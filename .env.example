# ─────────────────────────────────────────────────────────────
# CYRUS — frontend environment
# Copy to `.env.local` and fill in. Leave blank to run in DEMO MODE
# (sample data, nothing is saved, AI is not connected).
# ─────────────────────────────────────────────────────────────

# Supabase project URL and the public "anon"/publishable key.
# The anon key is safe in the browser: every table is protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put an OpenAI key here. Anything prefixed VITE_ is shipped to the browser.
# The OpenAI key lives only in the Supabase Edge Function secrets:
#   supabase secrets set OPENAI_API_KEY=sk-...
